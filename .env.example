# Copie este archivo como .env y cambie las claves antes de iniciar SICA.
# Los iniciadores leen solo estas variables y nunca imprimen sus contrasenas.
# Se permiten valores entre comillas cuando contienen espacios o caracteres especiales.
SICA_DB_HOST=localhost
SICA_DB_PORT=3307
SICA_DB_NAME=sica_db
SICA_DB_USER=sica_app
SICA_DB_PASSWORD=cambie_esta_clave_local
SICA_DB_ROOT_PASSWORD=cambie_esta_clave_root_local
